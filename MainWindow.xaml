<Window x:Class="StarlightRotationWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StarlightRotationWpf"
        mc:Ignorable="d"
        Title="Starlight Instrument Control" Height="428" Width="648">

    <!-- 1. 设置窗口的DataContext（数据上下文）为我们的ViewModel -->
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <StackPanel Orientation="Horizontal">
        <GroupBox Header="Starlight Control" Width="314" Margin="10,0,0,0" Height="333">
            <Grid Margin="15,15,-2,33">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Spacing -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Device 1 Info -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Device 1 Serial Number:" FontWeight="Bold" Margin="0,0,10,5"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Device1SerialNumber}" />

                <!-- Device 2 Info -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Device 2 Serial Number:" FontWeight="Bold" Margin="0,0,10,5"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Device2SerialNumber}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Device 1 Lux:" FontWeight="Bold" Margin="0,0,10,5"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Device1Reading}" />


                <TextBlock Grid.Row="4" Grid.Column="0" Text="Device 2 Lux:" FontWeight="Bold" Margin="0,0,10,5"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Device2Reading}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="1" Text="Light1 Currency(mA):" FontWeight="Bold" Margin="0,0,10,5"/>
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Light1CurrencyMilliAmpere}"/>
                <Slider Grid.Row="7" Grid.ColumnSpan="2"  Minimum="0" Maximum="1000" Value="{Binding Light1CurrencyMilliAmpere}"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="1" Text="Light2 Currency(mA):" FontWeight="Bold" Margin="0,0,10,5" />
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Light2CurrencyMilliAmpere}"/>
                <Slider Grid.Row="9" Grid.ColumnSpan="2" Minimum="0" Maximum="1000" Value="{Binding Light2CurrencyMilliAmpere}"/>
                <Button x:Name="buttonZeroDetector1" Content="Zero Detector-1" Grid.Row="11" Grid.ColumnSpan="2" Margin="0,10,0,0" Width="291" Command="{Binding ZeroDetector1Command}"/>
                <Button x:Name="buttonZeroDetector2" Content="Zero Detector-2" Grid.Row="12" Grid.ColumnSpan="2" Margin="0,10,0,0" Width="291" Command="{Binding ZeroDetector2Command}"/>
            </Grid>
        </GroupBox>
        <StackPanel>
            <GroupBox Header="Filter Wheel Control" Margin="10,0,0,0" Width="281">
                <Grid HorizontalAlignment="Center" Height="266" Margin="2,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="0.014mm" Command="{Binding FilterWheelRotateCommand}" CommandParameter="1"  Margin="0,0,0,10"/>
                    <Button Grid.Row="1" Content="0.035mm" Command="{Binding FilterWheelRotateCommand}" CommandParameter="2"  Margin="0,0,0,10"/>
                    <Button Grid.Row="2" Content="0.056mm" Command="{Binding FilterWheelRotateCommand}" CommandParameter="3"  Margin="0,0,0,10"/>
                    <Button Grid.Row="3" Content="0.084mm" Command="{Binding FilterWheelRotateCommand}" CommandParameter="4"  Margin="0,0,0,10"/>
                    <Button Grid.Row="4" Content="0.110mm" Command="{Binding FilterWheelRotateCommand}" CommandParameter="5"  Margin="0,0,0,10"/>
                    <Button Grid.Row="5" Content="0.140mm" Command="{Binding FilterWheelRotateCommand}" CommandParameter="6"  Margin="0,0,0,10"/>
                </Grid>
            </GroupBox>
            <GroupBox Header="Dual Axis Control">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Horizen"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Vertical"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Angle(Deg)"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HorizentalAngleInDegree}"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding VerticalAngleInDegree}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Step(Deg)"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HorizentalStepSizeInDegree}"/>
                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding VerticalStepSizeInDegree}"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Step Forward"/>
                    <Button Grid.Row="3" Grid.Column="1" Content="+"/>
                    <Button Grid.Row="3" Grid.Column="2" Content="+"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Step Backward"/>
                    <Button Grid.Row="4" Grid.Column="1" Content="-"/>
                    <Button Grid.Row="4" Grid.Column="2" Content="-"/>
                </Grid>

            </GroupBox>
        </StackPanel>
    </StackPanel>
</Window>