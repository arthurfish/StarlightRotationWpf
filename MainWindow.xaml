<Window x:Class="StarlightRotationWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StarlightRotationWpf"
        mc:Ignorable="d"
        Title="Starlight Instrument Control" Height="750" Width="1100"
        Background="#FFE6E6E6"
        FontFamily="Microsoft YaHei">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Styles are kept the same, they are well-defined. -->

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel 1: Top-Left (光源亮度控制) -->
        <ContentControl Grid.Row="0" Grid.Column="0" Template="{StaticResource PanelTemplate}" Tag="光源亮度控制"
                        DataContext="{Binding BrightnessControl}">
            <StackPanel Margin="5">
                <GroupBox Header="亮度计算">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="输入星等(-6~9) :" Margin="0,0,10,5"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InputMagnitude, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="光源亮度值 :" Margin="0,5,10,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CalculatedBrightness, StringFormat={}{0:F2}}" IsReadOnly="True" Margin="0,5,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Nit" Margin="5,5,0,0"/>
                    </Grid>
                </GroupBox>
                <Border BorderBrush="#FFAAAAAA" BorderThickness="1" Margin="8,10" Padding="10,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="当前亮度 :" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding CurrentBrightness, StringFormat={}{0:F2}}" IsReadOnly="True"/>
                        <TextBlock Grid.Column="2" Text="Nit" Margin="5,0,0,0"/>
                    </Grid>
                </Border>
                <GroupBox Header="亮度调节">
                    <StackPanel Margin="5">
                        <Grid Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" Text="小球光源调节步长(0~1000) :"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SmallSphereStep}"/>
                            <Slider Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0" Maximum="1000" Value="{Binding SmallSphereStep}" Style="{StaticResource CustomSliderStyle}"/>
                        </Grid>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" Text="大球光源调节步长(0~1000) :"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LargeSphereStep}"/>
                            <Slider Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0" Maximum="1000" Value="{Binding LargeSphereStep}" Style="{StaticResource CustomSliderStyle}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ContentControl>

        <ContentControl Grid.Row="2" Grid.Column="0" Template="{StaticResource PanelTemplate}" Tag="星点大小选择"
                DataContext="{Binding StarSelection}">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0" Header="星点位置" Padding="10" Margin="0,0,10,0">
                    <StackPanel>
                        <Grid>
                            <TextBox Text="{Binding TargetPosition}" Width="60" Padding="5,3" TextAlignment="Right"/>
                            <StackPanel HorizontalAlignment="Right" Margin="2">
                                <Button Content="▲" Padding="3,0" FontSize="8" Margin="0,0,0,1" Command="{Binding IncrementPositionCommand}"/>
                                <Button Content="▼" Padding="3,0" FontSize="8" Command="{Binding DecrementPositionCommand}"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="移动" Command="{Binding MoveToPositionCommand}" Margin="0,10,0,0"/>
                    </StackPanel>
                </GroupBox>
                <StackPanel Grid.Column="1">
                    <GroupBox Header="星点大小">
                        <!-- DataGrid 现在是只读的，因为编辑在下面进行 -->
                        <DataGrid ItemsSource="{Binding Stars}" SelectedItem="{Binding SelectedStar}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="序号" Binding="{Binding No}"/>
                                <DataGridTextColumn Header="星点大小/mm" Binding="{Binding Size}"/>
                                <DataGridTextColumn Header="星点张角/°" Binding="{Binding Angle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Header="编辑星点" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <UniformGrid Grid.Row="0" Rows="1">
                                <TextBlock Text="序号" HorizontalAlignment="Center"/>
                                <TextBlock Text="星点大小/mm" HorizontalAlignment="Center"/>
                                <TextBlock Text="星点张角/°" HorizontalAlignment="Center"/>
                            </UniformGrid>
                            <UniformGrid Grid.Row="1" Rows="1" Margin="0,5,0,0">
                                <!-- 添加绑定到 EditStar... 属性 -->
                                <TextBox Margin="2,0" Text="{Binding EditStarNo, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="#FFE6E6E6"/>
                                <TextBox Margin="2,0" Text="{Binding EditStarSize, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Margin="2,0" Text="{Binding EditStarAngle, UpdateSourceTrigger=PropertyChanged}"/>
                            </UniformGrid>
                        </Grid>
                    </GroupBox>
                    <!-- 确保按钮绑定到正确的命令 -->
                    <Button Content="更新" Command="{Binding UpdateStarCommand}" HorizontalAlignment="Right" Margin="0,10,2,0"/>
                </StackPanel>
            </Grid>
        </ContentControl>

        <!-- Panel 3: Top-Right (转动控制) -->
        <!-- HERE WE USE THE REUSABLE USER CONTROL! -->
        <ContentControl Grid.Row="0" Grid.Column="2" Template="{StaticResource PanelTemplate}" Tag="{Binding RotationControl.Title}">
            <local:MotionControlView DataContext="{Binding RotationControl}" Margin="5"/>
        </ContentControl>

        <!-- Panel 4: Bottom-Right (滚动控制) -->
        <!-- AND WE USE IT AGAIN! -->
        <ContentControl Grid.Row="2" Grid.Column="2" Template="{StaticResource PanelTemplate}" Tag="{Binding RollControl.Title}">
            <local:MotionControlView DataContext="{Binding RollControl}" Margin="5"/>
        </ContentControl>

        <!-- Dashed Line Separators -->
        <Rectangle Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="1" Stroke="Gray" StrokeDashArray="4 2"/>
        <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="1" Stroke="Gray" StrokeDashArray="4 2"/>

    </Grid>
</Window>