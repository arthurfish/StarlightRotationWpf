<Window x:Class="StarlightRotationWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StarlightRotationWpf"
        mc:Ignorable="d"
        Title="Starlight Instrument Control" Height="879" Width="813">

    <!-- 1. 设置窗口的DataContext（数据上下文）为我们的ViewModel -->
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <StackPanel Orientation="Horizontal">
        <StackPanel.Resources >
            <Style TargetType="TextBlock" >
                <Setter Property="FontSize" Value="23"/>
            </Style>
            <Style TargetType="GroupBox">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="Margin" Value="10"/>
                <Setter Property="Padding" Value="10"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontSize" Value="23"/>
            </Style>
        </StackPanel.Resources>

        <StackPanel Orientation="Vertical">
            <GroupBox Header="光源亮度控制">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="33"/>
                        <RowDefinition Height="33"/>
                        <RowDefinition Height="33"/>
                        <RowDefinition Height="33"/>
                        <RowDefinition Height="33"/>
                        <RowDefinition Height="33"/>
                        <RowDefinition Height="33"/>
                        <RowDefinition Height="33"/>
                        <RowDefinition Height="33"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="期望星等(-6~9)" Grid.Row="0" Grid.Column="0"/>
                    <TextBox Text="{Binding ExpectedMagnitude}" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Text="对应期望亮度" Grid.Row="1" Grid.Column="0"/>
                    <TextBlock Text="{Binding ExpectedBrightness}" Grid.Row="1" Grid.Column="1"/>

                    <TextBlock Text="当前亮度(Nit)" Grid.Row="2" Grid.Column="0"/>
                    <TextBlock Text="{Binding Device2Reading}" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock Text="小球电流输入(mA)" Grid.Row="4" Grid.Column="0"/>
                    <TextBlock Grid.Row="4" Grid.Column="1">
                        <TextBlock.Text>
                            <Binding Path="Light2CurrencyMilliAmpere" UpdateSourceTrigger="PropertyChanged"/>
                        </TextBlock.Text>
                    </TextBlock>
                    <Slider Value="{Binding Light2CurrencyMilliAmpere}" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Maximum="1000" Minimum="0" IsSnapToTickEnabled="True" TickFrequency="0.1" LargeChange="100"/>

                    <TextBlock Text="大球电流输入(mA)" Grid.Row="7" Grid.Column="0"/>
                    <TextBlock Grid.Row="7" Grid.Column="1">
                        <TextBlock.Text>
                            <Binding Path="Light1CurrencyMilliAmpere" UpdateSourceTrigger="PropertyChanged"/>
                        </TextBlock.Text>
                    </TextBlock>
                    <Slider Value="{Binding Light1CurrencyMilliAmpere}" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Maximum="1000" Minimum="0" IsSnapToTickEnabled="True" TickFrequency="0.1" LargeChange="100"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="星点大小选择">
                <GroupBox.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="FontSize" Value="23"/>
                    </Style>
                </GroupBox.Resources>
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="33"/>
                        <RowDefinition Height="33"/>
                        <RowDefinition Height="33"/>
                        <RowDefinition Height="33"/>
                        <RowDefinition Height="33"/>
                        <RowDefinition Height="33"/>
                        <RowDefinition Height="33"/>
                        <RowDefinition Height="33"/>
                    </Grid.RowDefinitions>

                    <Border>
                        <TextBlock Text="{Binding FilterWheelPositionString}" Grid.Row="0" Grid.Column="0"/>
                    </Border>
                    <Button Content="0.002° (0.014mm)"  Command="{Binding FilterWheelRotateCommand}" CommandParameter="1"  Grid.Row="2" Grid.Column="0"/>
                    <Button Content="0.005° (0.035mm)"  Command="{Binding FilterWheelRotateCommand}" CommandParameter="2"  Grid.Row="3" Grid.Column="0"/>
                    <Button Content="0.008° (0.056mm)"  Command="{Binding FilterWheelRotateCommand}" CommandParameter="3"  Grid.Row="4" Grid.Column="0"/>
                    <Button Content="0.012° (0.084mm)"  Command="{Binding FilterWheelRotateCommand}" CommandParameter="4"  Grid.Row="5" Grid.Column="0"/>
                    <Button Content="0.016° (0.110mm)"  Command="{Binding FilterWheelRotateCommand}" CommandParameter="5"  Grid.Row="6" Grid.Column="0"/>
                    <Button Content="0.020° (0.140mm)"  Command="{Binding FilterWheelRotateCommand}" CommandParameter="6"  Grid.Row="7" Grid.Column="0"/>

                </Grid>
            </GroupBox>
        </StackPanel>

        <StackPanel Orientation="Vertical">
            <GroupBox Header="转台控制">
                <StackPanel Orientation="Vertical">
                    <GroupBox Header="转动控制">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="转动速度" Grid.Row="0" Grid.Column="0"/>
                            <TextBox Text="{Binding HorizentalRotationSpeed}" Grid.Row="0" Grid.Column="1"/>

                            <TextBlock Text="期望角度(度)" Grid.Row="1" Grid.Column="0"/>
                            <TextBox Text="{Binding HorizentalAngleInDegree}" Grid.Row="1" Grid.Column="1"/>

                            <Button Content="执行移动" Command="{Binding DualAxisRotationGoHorizental}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"/>

                            <TextBlock Text="当前角度(度)" Grid.Row="3" Grid.Column="0"/>
                            <TextBlock Text="{Binding GotHorizontalAngleInDegree }" Grid.Row="3" Grid.Column="1"/>

                            <Button Content="设置零位(度)" Command="{Binding DualAxisRotationSetHorizentalBias}" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"/>

                            <TextBlock Text="转动步长(度)" Grid.Row="6" Grid.Column="0"/>
                            <TextBox Text="{Binding HorizentalStepSizeInDegree}" Grid.Row="6" Grid.Column="1"/>

                            <Button Content="正方向转动" Command="{Binding DualAxisRotationHorizenAdd}" Grid.Row="7" Grid.Column="0"/>
                            <Button Content="负方向转动" Command="{Binding DualAxisRotationHorizenMinus}" Grid.Row="7" Grid.Column="1"/>
                            <Button Content="停止" Command="{Binding DualAxisRotationStop}" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="滚动控制">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="33"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="滚动速度" Grid.Row="0" Grid.Column="0"/>
                            <TextBox Text="{Binding VerticalRotationSpeed}" Grid.Row="0" Grid.Column="1"/>

                            <TextBlock Text="期望角度(度)" Grid.Row="1" Grid.Column="0"/>
                            <TextBox Text="{Binding VerticalAngleInDegree}" Grid.Row="1" Grid.Column="1"/>

                            <Button Content="执行移动" Command="{Binding DualAxisRotationGoVertical}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"/>

                            <TextBlock Text="当前角度(度)" Grid.Row="3" Grid.Column="0"/>
                            <TextBlock Text="{Binding GotVerticalAngleInDegree }" Grid.Row="3" Grid.Column="1"/>

                            <Button Content="设置零位(度)" Command="{Binding DualAxisRotationSetVerticalBias}" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"/>

                            <TextBlock Text="转动步长(度)" Grid.Row="6" Grid.Column="0"/>
                            <TextBox Text="{Binding VerticalStepSizeInDegree}" Grid.Row="6" Grid.Column="1"/>

                            <Button Content="正方向转动" Command="{Binding DualAxisRotationVerticalAdd}" Grid.Row="7" Grid.Column="0"/>
                            <Button Content="负方向转动" Command="{Binding DualAxisRotationVerticalMinus}" Grid.Row="7" Grid.Column="1"/>
                            <Button Content="停止" Command="{Binding DualAxisRotationStop}" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"/>
                        </Grid>
                    </GroupBox>

                </StackPanel>
            </GroupBox>
        </StackPanel>
    </StackPanel>
</Window>