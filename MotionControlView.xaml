<!-- MotionControlView.xaml -->
<UserControl x:Class="StarlightRotationWpf.MotionControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StarlightRotationWpf"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:MotionControlViewModel}"
             d:DesignHeight="300" d:DesignWidth="500">
    <StackPanel>
        <!-- 使用Grid布局以更好地控制对齐 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <!-- 间距 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="转动速度" Grid.Column="0">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider VerticalAlignment="Center" Margin="0,0,5,0"
                            Value="{Binding Speed}" Maximum="20" Style="{StaticResource CustomSliderStyle}"/>
                    <TextBox Grid.Column="1" Text="{Binding Speed, StringFormat={}{0:F1}}" Width="60"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="转动加速度" Grid.Column="2">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider VerticalAlignment="Center" Margin="0,0,5,0"
                            Value="{Binding Acceleration}" Maximum="20" Style="{StaticResource CustomSliderStyle}"/>
                    <TextBox Grid.Column="1" Text="{Binding Acceleration, StringFormat={}{0:F1}}" Width="60"/>
                </Grid>
            </GroupBox>
        </Grid>

        <UniformGrid Rows="1" Margin="0,10,0,0">
            <GroupBox Header="转动角度">
                <StackPanel HorizontalAlignment="Center" Margin="5">
                    <Grid>
                        <TextBox Text="{Binding TargetAngle, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <TextBlock Text="(°)" HorizontalAlignment="Right" Margin="5,0" IsHitTestVisible="False"/>
                    </Grid>
                    <Button Content="移动" Command="{Binding MoveCommand}" Margin="0,10,0,0"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="设置零位">
                <StackPanel HorizontalAlignment="Center" Margin="5">
                    <Grid>
                        <TextBox Text="{Binding ZeroOffset, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <TextBlock Text="(°)" HorizontalAlignment="Right" Margin="5,0" IsHitTestVisible="False"/>
                    </Grid>
                    <Button Content="执行" Command="{Binding SetZeroCommand}" Margin="0,10,0,0"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="转动步长">
                <StackPanel HorizontalAlignment="Center" Margin="5">
                    <Grid>
                        <TextBox Text="{Binding StepSize, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <TextBlock Text="(°)" HorizontalAlignment="Right" Margin="5,0" IsHitTestVisible="False"/>
                    </Grid>
                    <UniformGrid Rows="1" Margin="0,10,0,0">
                        <Button Content="+" Command="{Binding StepPositiveCommand}" Margin="2,0"/>
                        <Button Content="-" Command="{Binding StepNegativeCommand}" Margin="2,0"/>
                    </UniformGrid>
                </StackPanel>
            </GroupBox>
        </UniformGrid>
        <Button Content="停止" Command="{Binding StopCommand}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
    </StackPanel>
</UserControl>