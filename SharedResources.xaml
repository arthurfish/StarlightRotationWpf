<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="PanelTemplate" TargetType="ContentControl">
        <Border Margin="15" BorderBrush="#FFB0B0B0" BorderThickness="1" Background="#FFF0F0F0">
            <Grid>
                <Border Background="#FF4A86E8" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,-15,0,0" Padding="15,3">
                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                </Border>
                <ContentPresenter Margin="10,20,10,10"/>
            </Grid>
        </Border>
    </ControlTemplate>
    <!-- Other styles remain unchanged... -->
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="#FFAAAAAA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="3,-2" Background="{Binding Background, ElementName=groupBoxBorder}" Padding="3,0" FontSize="12"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="3,0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Background" Value="#FFE0E0E0"/>
        <Setter Property="BorderBrush" Value="#FFADADAD"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="CustomSliderStyle" TargetType="{x:Type Slider}">
        <!-- Slider Style unchanged -->
    </Style>
</ResourceDictionary>