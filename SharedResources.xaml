<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="PanelTemplate" TargetType="ContentControl">
        <Border Margin="15" BorderBrush="#FFB0B0B0" BorderThickness="1" Background="#FFF0F0F0">
            <Grid>
                <Border Background="#FF4A86E8" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,-15,0,0" Padding="15,3">
                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                </Border>
                <ContentPresenter Margin="10,20,10,10"/>
            </Grid>
        </Border>
    </ControlTemplate>
    <!-- Other styles remain unchanged... -->

    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="#FFAAAAAA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Margin" Value="3"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <!-- 我们在这里定义了名为 groupBoxBorder 的 Border -->
                    <Border x:Name="groupBoxBorder" 
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3" 
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- GroupBox Header -->
                            <!-- 我们将 Header 放在 Border 内部，并进行一些布局调整使其看起来像在边框上 -->
                            <Border Grid.Row="0">
                                <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              Margin="10,-9,0,0"
                                              VerticalAlignment="Top"
                                              HorizontalAlignment="Left">
                                    <ContentPresenter.ContentTemplate>
                                        <DataTemplate>
                                            <!-- 现在这个绑定可以正常工作了 -->
                                            <!-- 我们使用 RelativeSource 找到模板化的父级(GroupBox)，并绑定到它的背景 -->
                                            <TextBlock Text="{Binding}"
                                                   Padding="3,0" FontSize="18"
                                                   Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type GroupBox}}}"/>
                                        </DataTemplate>
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>
                            </Border>

                            <!-- GroupBox Content -->
                            <ContentPresenter Grid.Row="1" 
                                          Margin="{TemplateBinding Padding}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="18"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="3,0"/>
        <Setter Property="FontSize" Value="18"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Background" Value="#FFE0E0E0"/>
        <Setter Property="BorderBrush" Value="#FFADADAD"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="FontSize" Value="18"/>
    </Style>
    <Style x:Key="CustomSliderStyle" TargetType="{x:Type Slider}">
        <!-- Slider Style unchanged -->
    </Style>

</ResourceDictionary>